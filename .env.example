# AI Exam Proctoring System Environment Configuration

# Database Configuration
DB_HOST=mysql
DB_USER=examuser
DB_PASSWORD=exampass
DB_NAME=exam_proctoring

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node.js Configuration
NODE_ENV=development
PORT=5000

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000

# AI Services Configuration
FACE_SERVICE_URL=http://face_service:8000
OBJECT_SERVICE_URL=http://object_service:8000
AUDIO_SERVICE_URL=http://audio_service:8000
BEHAVIOR_SERVICE_URL=http://behavior_service:8000

# Logging Configuration
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE=10mb
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_TIMEOUT=3600

# AI Model Configuration
CONFIDENCE_THRESHOLD=0.5
ALERT_THRESHOLD=0.7

# Privacy Configuration
ENABLE_VIDEO_OBFUSCATION=false
DATA_RETENTION_DAYS=30

# Performance Configuration
MAX_CONCURRENT_SESSIONS=100
FRAME_RATE=15
PROCESSING_TIMEOUT=5000